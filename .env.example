# OpenAI API key with access to gpt-live-1 (paid tier required; the free tier
# cannot open a session). The same key also covers research when the provider
# below is "openai", which is what a deployed copy uses.
OPENAI_API_KEY=sk-...

# Password for the /admin area
ADMIN_PASSWORD=change-me
# Random string used to sign the admin session cookie
ADMIN_SESSION_SECRET=change-me-too

# Models
LIVE_MODEL=gpt-live-1
BACKEND_MODEL=gpt-5.6-terra
# Research provider: cli | openai | anthropic.
# A subscription only works through a CLI signed in on a machine, so locally
# the default is "cli" and research costs nothing. A serverless host has no CLI
# to spawn and falls back to "openai" when OPENAI_API_KEY is set, "anthropic"
# otherwise.
# RESEARCH_PROVIDER=cli
# Model for the CLI path (sonnet, opus, haiku, or a full model id)
RESEARCH_MODEL=sonnet
# Model for the OpenAI path. Terra supports web search and is the cheap end of
# the models that do; roughly $0.10 of tokens per business researched.
# RESEARCH_OPENAI_MODEL=gpt-5.6-terra
# How much the web search reads: low | medium | high. More is better research
# and more tokens.
# RESEARCH_SEARCH_CONTEXT=medium
# Model and key for the Anthropic path
# RESEARCH_API_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...
# Voices: gleam/meridian are North American, delta/cinder Southern US,
# quartz/ripple Australian, vesper British, willow/stone Irish
LIVE_VOICE=gleam

# Optional: full path to claude.exe if it is not on PATH
# CLAUDE_CLI_PATH=
# Optional: send OpenAI calls somewhere else (a gateway, a proxy, a test stub)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Storage. With neither set, data is JSON files under data/, which is right
# locally and wrong on a serverless host. Set both to use a Redis-compatible
# REST store (Upstash and Vercel's KV integration both provide these).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Public base URL used when building customer links (no trailing slash)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
