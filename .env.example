# OpenAI API key with access to gpt-live-1 (paid tier required; the free tier cannot open a session).
# Voice only: research runs through the Claude Code CLI on your Claude subscription.
OPENAI_API_KEY=sk-...

# Password for the /admin area
ADMIN_PASSWORD=change-me
# Random string used to sign the admin session cookie
ADMIN_SESSION_SECRET=change-me-too

# Models
LIVE_MODEL=gpt-live-1
BACKEND_MODEL=gpt-5.6-terra
# Research model, passed to the Claude CLI (sonnet, opus, haiku, or a full model id)
RESEARCH_MODEL=sonnet
# Voices: gleam/meridian are North American, delta/cinder Southern US,
# quartz/ripple Australian, vesper British, willow/stone Irish
LIVE_VOICE=gleam

# Optional: full path to claude.exe if it is not on PATH
# CLAUDE_CLI_PATH=

# Public base URL used when building customer links (no trailing slash)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
